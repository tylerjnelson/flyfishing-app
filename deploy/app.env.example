# Fly Fish runtime environment — TEMPLATE / SCHEMA ONLY.
#
# The real file lives at /etc/flyfish/app.env (root-owned, 0600) and is
# referenced by flyfish.service via EnvironmentFile=. It is gitignored
# (contains secrets). This example tracks the *set of required keys* so the
# service can be reconstructed. Copy to /etc/flyfish/app.env and fill in.
#
# Keep this file in sync when you add/remove an env key.

# --- Core ---
APP_SECRET_KEY=change-me-long-random-hex        # JWT signing (HS256); rotating logs everyone out
DATABASE_URL=postgresql+asyncpg://user:pass@localhost/flyfish
UPLOADS_PATH=/opt/flyfish/uploads               # note-image upload dir

# --- LLM engine ---
OLLAMA_BASE_URL=http://localhost:11434
FLYFISH_CHAT_ENGINE=llamacpp                     # ollama | llamacpp
FLYFISH_HARNESS_MODE=agentic                     # twopass | agentic

# --- Email (magic-link sign-in) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=noreply@waflyfish.com                  # must be on a Resend-verified domain

# --- External data APIs ---
AIRNOW_API_KEY=xxxxxxxx
HERE_API_KEY=xxxxxxxx                             # routing/geocoding — see spec §11.1 (never call live in tests)
NPS_API_KEY=xxxxxxxx

# --- Ops ---
BACKUP_TARGET=                                    # backup destination (path/bucket)
